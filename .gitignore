# Environment / secrets - NEVER commit these
**/.env
**/.env.local
**/.env.production
**/.env.*
*.env
!.env.example
!**/.env.example

# Python
**/__pycache__/
*.py[cod]
*.pyd
.Python
*.egg-info/
**/dist/
**/build/
**/.venv/
**/venv/
**/env/

# Local data, databases, and generated artifacts
ParsedMatch
*.db
*.sqlite3
backend/test.db
backend/catboost_info/
backend/cricsheet_data/
backend/*.log
backend/*_log.txt
backend/*_err.txt
frontend/vite_*.txt

# Alembic
backend/alembic/versions/*.pyc

# ML models / large files
*.pkl
*.joblib
*.h5
*.pt
*.bin
models/trained/

# Node / Frontend
**/node_modules/
**/.npm/
**/dist/
**/build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage
**/.pytest_cache/
.coverage
.coverage.*
**/htmlcov/
**/.mypy_cache/
**/.ruff_cache/

# Logs
*.log
logs/
